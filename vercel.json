{
  "redirects": [
    {
      "source": "/app/ch-play",
      "destination": "https://play.google.com/store/apps/details?id=com.eaagri.app",
      "permanent": false
    },
    {
      "source": "/ch-play",
      "destination": "https://play.google.com/store/apps/details?id=com.eaagri.app",
      "permanent": false
    },
    {
      "source": "/app/chplay",
      "destination": "https://play.google.com/store/apps/details?id=com.eaagri.app",
      "permanent": false
    },
    {
      "source": "/chplay",
      "destination": "https://play.google.com/store/apps/details?id=com.eaagri.app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}